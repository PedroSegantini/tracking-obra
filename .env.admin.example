# SOMENTE servidor/bootstrap. Nunca use prefixo VITE_ nestas credenciais.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave com quebras escapadas como \n; mantenha as aspas.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA\n-----END PRIVATE KEY-----\n"
# Bootstrap: conta que você criará antes no Authentication.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
INITIAL_BUDGET_CENTS=0

# Alteração de senha: chave Web do mesmo projeto, autorizada para a API Identity Toolkit.
# Se omitida na Vercel, o servidor usa VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=
# Avisos por e-mail: apenas servidor, nunca prefixar com VITE_.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# E-mail simples, sem nome/apelido: exemplo remetente@example.com
SMTP_FROM=
# Opcional: contato usado no texto e reply-to do aviso.
ADMIN_CONTACT_EMAIL=
