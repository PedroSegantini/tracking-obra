rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true; }
    function isAdmin() { return isMember() && get(memberPath()).data.role == 'admin' && request.auth.token.role == 'admin'; }
    function canAccess(renovationId) {
      let project = get(/databases/$(database)/documents/renovations/$(renovationId)).data;
      return isMember() && project.get('deleted', false) == false && (isAdmin() || {'id': request.auth.uid, 'name': get(memberPath()).data.name} in project.get('members', []));
    }
    function canCreateCategory(renovationId) {
      let path = /databases/$(database)/documents/renovations/$(renovationId);
      return (exists(path) && canAccess(renovationId)) || (!exists(path) && isAdmin() && existsAfter(path) && getAfter(path).data.deleted == false);
    }
    function auditCreate(d) {
      return d.createdBy == request.auth.uid && d.createdAt == request.time && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function auditUpdate(d) {
      return d.createdBy == resource.data.createdBy && d.createdAt == resource.data.createdAt && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function validCategory(d) {
      return d.keys().hasAll(['ID', 'name', 'color', 'active', 'renovationId'])
        && d.keys().hasOnly(['ID', 'name', 'color', 'active', 'renovationId'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.renovationId is string && d.renovationId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.ID is string && d.ID.matches('^[a-zA-Z0-9]{20}$')
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$') && d.active is bool;
    }
    function categoryExists(renovationId, d) { return exists(/databases/$(database)/documents/categories/$(d.categoryId)) && get(/databases/$(database)/documents/categories/$(d.categoryId)).data.renovationId == renovationId; }
    function activeCategory(renovationId, d) { return get(/databases/$(database)/documents/categories/$(d.categoryId)).data.active == true; }
    function validExpense(renovationId, d) {
      return d.keys().hasAll(['amountCents', 'date', 'categoryId', 'paymentMethod', 'installments', 'paidInstallments', 'description', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasOnly(['amountCents', 'date', 'categoryId', 'paymentMethod', 'installments', 'paidInstallments', 'description', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000000
        && d.date is string && (d.date.matches('^(19|20|21)[0-9]{2}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$') || d.date.matches('^(2000|(19|20|21)(0[48]|[2468][048]|[13579][26]))-02-29$'))
        && d.categoryId is string && d.categoryId.matches('^[a-zA-Z0-9]{20}$') && categoryExists(renovationId, d)
        && d.paymentMethod in ['pix', 'credit'] && d.installments is int && d.installments >= 1 && d.installments <= 600
        && d.paidInstallments is int && d.paidInstallments >= 0 && d.paidInstallments <= d.installments
        && (d.paymentMethod == 'credit' || (d.installments == 1 && d.paidInstallments == 1))
        && d.description is string && d.description.size() <= 500;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if canAccess(resource.data.renovationId);
      allow create: if canCreateCategory(request.resource.data.renovationId)
        && id == request.resource.data.ID
        && validCategory(request.resource.data) && request.resource.data.active == true;
      allow update: if canAccess(resource.data.renovationId) && validCategory(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }
    match /renovations/{renovationId} {
      allow get: if isMember() && (isAdmin() || (resource.data.deleted == false && {'id': request.auth.uid, 'name': get(memberPath()).data.name} in resource.data.members));
      allow list: if isMember() && (isAdmin() || (resource.data.deleted == false && {'id': request.auth.uid, 'name': get(memberPath()).data.name} in resource.data.members));
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'schemaVersion', 'name', 'budgetCents', 'members', 'deleted'])
        && request.resource.data.keys().hasOnly(['id', 'schemaVersion', 'name', 'budgetCents', 'members', 'deleted'])
        && request.resource.data.id == renovationId && request.resource.data.schemaVersion == 3 && renovationId.matches('^[a-zA-Z0-9]{20}$')
        && request.resource.data.members == [{'id': request.auth.uid, 'name': get(memberPath()).data.name}]
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.budgetCents is int && request.resource.data.budgetCents == 0
        && request.resource.data.deleted == false;
      allow delete: if false;
      allow update: if canAccess(renovationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['budgetCents'])
        && request.resource.data.budgetCents is int && request.resource.data.budgetCents >= 0 && request.resource.data.budgetCents <= 100000000000;
      match /expenses/{id} {
        allow read: if canAccess(renovationId);
        allow create: if canAccess(renovationId) && validExpense(renovationId, request.resource.data) && activeCategory(renovationId, request.resource.data) && auditCreate(request.resource.data);
        allow update: if canAccess(renovationId) && validExpense(renovationId, request.resource.data) && auditUpdate(request.resource.data)
          && (request.resource.data.categoryId == resource.data.categoryId || activeCategory(renovationId, request.resource.data));
        allow delete: if canAccess(renovationId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
